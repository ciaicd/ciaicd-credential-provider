# Rust build output; Cargo.lock is intentionally versioned for this executable.
/target/
/artifacts/
/dist/
/coverage/
*.profraw
*.profdata
lcov.info

# Local secrets and credentials.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
kubeconfig
