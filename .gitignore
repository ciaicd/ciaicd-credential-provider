**/.terraform/*
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
!*.tfvars.example
!*.tfvars.json.example
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Editor and OS files.
.idea/
.vscode/
.DS_Store
*.swp
*.swo
*~
__pycache__/
